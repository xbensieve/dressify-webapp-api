# =====================
# Server
# =====================
NODE_ENV=development
PORT=5000
BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

# =====================
# Database
# =====================
MONGO_URI=mongodb://localhost:27017/ecommerce-project

# =====================
# Redis
# =====================
REDIS_USERNAME=default
REDIS_PASSWORD=
REDIS_HOST=localhost
REDIS_PORT=6379

# =====================
# JWT
# =====================
JWT_SECRET=change_me_in_production_min_32_chars
JWT_REFRESH_SECRET=change_me_in_production_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# =====================
# Cloudinary
# =====================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# =====================
# Email (Gmail SMTP)
# =====================
ADMIN_EMAIL=
ADMIN_PASSWORD=

# =====================
# Google OAuth
# =====================
GOOGLE_CLIENT_ID=

# =====================
# Gemini AI
# =====================
GEMINI_API_KEY=

# =====================
# VNPay
# =====================
VNP_TMN_CODE=
VNP_HASH_SECRET=
VNP_BASEURL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_RETURN_URL=http://localhost:5000/api/vnpay/handle-payment-response
VNP_COMMAND=pay
VNP_CURRCODE=VND
VNP_VERSION=2.1.0
VNP_LOCALE=vn

# =====================
# Timezone
# =====================
TIMEZONE=Asia/Ho_Chi_Minh
